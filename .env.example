# ============================================================
# .env.example — copy to .env and fill in. NEVER commit the real .env.
# ============================================================

# --- SOURCE: Remote Supabase "Data Warehouse" (READ-ONLY) ---
# Used ONLY to pull a clone via pg_dump. Do not write to this.
SOURCE_DB_HOST=db.<project-ref>.supabase.co
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=postgres
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=

# --- LOCAL: Your local Postgres clone (where ALL analysis runs) ---
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=mas_warehouse
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=
